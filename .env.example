# Core paths
PENNY_STOCK_DB_PATH=./data/penny_stock_radar.sqlite3
PENNY_STOCK_CACHE_DIR=./data/cache
PENNY_STOCK_REPLAY_DIR=./data/replay
PENNY_STOCK_LOG_LEVEL=INFO
PENNY_STOCK_USE_MOCK_MARKET_DATA=true
PENNY_STOCK_MARKET_DATA_MODE=replay
PENNY_STOCK_LIVE_MARKET_PROVIDER=auto
PENNY_STOCK_LIVE_MARKET_TIMEOUT_SECONDS=10
PENNY_STOCK_POLYGON_BASE_URL=https://api.polygon.io
PENNY_STOCK_ALPACA_DATA_BASE_URL=https://data.alpaca.markets
PENNY_STOCK_ALPACA_MARKET_DATA_FEED=iex

# Market data providers
# Used later for live or near-real-time monitoring.
PENNY_STOCK_POLYGON_API_KEY=
PENNY_STOCK_ALPACA_API_KEY=
PENNY_STOCK_ALPACA_SECRET_KEY=

# SEC filings
# SEC requests should send a descriptive User-Agent/contact header.
PENNY_STOCK_SEC_USER_AGENT=penny-stock-radar/0.1 (your-email@example.com)
PENNY_STOCK_SEC_CONTACT_EMAIL=your-email@example.com

# Premarket / regular-session defaults
PENNY_STOCK_PREMARKET_MIN_DOLLAR_VOLUME=100000
PENNY_STOCK_PREMARKET_MIN_TRADE_COUNT=25
PENNY_STOCK_PREMARKET_MAX_SPREAD_PCT=0.08
PENNY_STOCK_REGULAR_OPENING_RANGE_MINUTES=5
PENNY_STOCK_REGULAR_EXTENSION_Z_THRESHOLD=2.0

# Social / narrative providers
PENNY_STOCK_REDDIT_CLIENT_ID=
PENNY_STOCK_REDDIT_CLIENT_SECRET=
PENNY_STOCK_X_BEARER_TOKEN=
PENNY_STOCK_STOCKTWITS_ACCESS_TOKEN=
