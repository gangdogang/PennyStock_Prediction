# Core paths
PENNY_STOCK_DB_PATH=./data/penny_stock_radar.sqlite3
PENNY_STOCK_CACHE_DIR=./data/cache
PENNY_STOCK_REPLAY_DIR=./data/replay
PENNY_STOCK_LOG_LEVEL=INFO
PENNY_STOCK_USE_MOCK_MARKET_DATA=true
PENNY_STOCK_MARKET_DATA_MODE=replay
PENNY_STOCK_LIVE_MARKET_PROVIDER=kis
PENNY_STOCK_LIVE_MARKET_TIMEOUT_SECONDS=10
PENNY_STOCK_LIVE_OBSERVABILITY_ENABLED=true
PENNY_STOCK_LIVE_OBSERVABILITY_PATH=./automation/logs/live_metrics.jsonl
PENNY_STOCK_BACKTEST_COVERAGE_REPORT_DIR=./automation/state/backtest_coverage
PENNY_STOCK_BACKTEST_COVERAGE_GATE_PATH=./automation/state/backtest_coverage_gate_status.json
PENNY_STOCK_BACKTEST_COVERAGE_GATE_PCT=60.0

# Market data providers
# PENNY_STOCK_LIVE_MARKET_PROVIDER: kis | disabled
PENNY_STOCK_KIS_BASE_URL=https://openapi.koreainvestment.com:9443
PENNY_STOCK_KIS_WEBSOCKET_URL=ws://ops.koreainvestment.com:21000
PENNY_STOCK_KIS_MARKET_DIV_CODE=J
PENNY_STOCK_KIS_CUSTTYPE=P
PENNY_STOCK_KIS_APP_KEY=
PENNY_STOCK_KIS_APP_SECRET=
PENNY_STOCK_KIS_NASDAQ_MASTER_PATH=./data/kis_master/NASMST.COD
PENNY_STOCK_KIS_NYSE_MASTER_PATH=./data/kis_master/NYSMST.COD
PENNY_STOCK_KIS_AMEX_MASTER_PATH=./data/kis_master/AMSMST.COD
PENNY_STOCK_ALPACA_API_KEY=
PENNY_STOCK_ALPACA_SECRET_KEY=
PENNY_STOCK_ALPACA_DATA_BASE_URL=https://data.alpaca.markets
PENNY_STOCK_ALPACA_MARKET_DATA_FEED=iex

# SEC filings
# SEC requests should send a descriptive User-Agent/contact header.
PENNY_STOCK_SEC_USER_AGENT=penny-stock-radar/0.1 (your-email@example.com)
PENNY_STOCK_SEC_CONTACT_EMAIL=your-email@example.com

# Premarket / regular-session defaults
# `penny` = legacy 0.30-5.00 universe
# `small_cap` = broader small-cap momentum scope
# `all` = all-market momentum scan with the same spread/liquidity checks
PENNY_STOCK_MARKET_SCOPE=penny
PENNY_STOCK_PREMARKET_MIN_DOLLAR_VOLUME=100000
PENNY_STOCK_PREMARKET_MIN_TRADE_COUNT=25
PENNY_STOCK_PREMARKET_MAX_SPREAD_PCT=0.08
PENNY_STOCK_REGULAR_OPENING_RANGE_MINUTES=5
PENNY_STOCK_REGULAR_EXTENSION_Z_THRESHOLD=2.0

# Automated paper trading
PENNY_STOCK_PAPER_TRADING_ENABLED=true
PENNY_STOCK_PAPER_TRADE_DIR=./sample_outputs/paper_trading
PENNY_STOCK_PAPER_INITIAL_CAPITAL=10000
PENNY_STOCK_PAPER_MAX_OPEN_POSITIONS=3
PENNY_STOCK_PAPER_ENTRY_SIZE_FRACTION=0.20
PENNY_STOCK_PAPER_ADD_SIZE_FRACTION=0.10
PENNY_STOCK_PAPER_ADD_TRIGGER_PCT=3.0
PENNY_STOCK_PAPER_MAX_ADDS_PER_POSITION=1
PENNY_STOCK_PAPER_ENTRY_SCORE_MIN=3.25
PENNY_STOCK_PAPER_NEWS_ENTRY_SCORE_MIN=3.0
PENNY_STOCK_PAPER_STOP_LOSS_PCT=4.0
PENNY_STOCK_PAPER_PROFIT_ACTIVATION_PCT=6.0
PENNY_STOCK_PAPER_TRAILING_STOP_PCT=3.0
PENNY_STOCK_PAPER_AI_CONSENSUS_ENABLED=true
PENNY_STOCK_PAPER_AI_CONSENSUS_LIMIT=3
PENNY_STOCK_PAPER_AI_REFRESH_SECONDS=180
PENNY_STOCK_PAPER_AI_ESCALATION_ENABLED=true
PENNY_STOCK_PAPER_AI_ESCALATION_MODEL=gemini-3.1-pro-preview
PENNY_STOCK_PAPER_AI_ESCALATION_LIMIT=1
PENNY_STOCK_PAPER_AI_ESCALATION_MIN_CONFIDENCE=45
PENNY_STOCK_PAPER_AI_ESCALATION_MAX_CONFIDENCE=75
#
# Fill model realism tuning
PENNY_STOCK_PAPER_HALT_RESUME_DECAY_MINUTES=3.0
PENNY_STOCK_PAPER_VOLUME_CAP_SMALL_MARKET_CAP_THRESHOLD=500000000
PENNY_STOCK_PAPER_VOLUME_CAP_SMALL_MARKET_CAP_SCALE=0.5
PENNY_STOCK_PAPER_CAPACITY_LIMITED_PCT=2.0
PENNY_STOCK_PAPER_PARTICIPATION_SLIPPAGE_ENABLED=true
PENNY_STOCK_PAPER_PARTICIPATION_SLIPPAGE_SOFT_PCT=1.0
PENNY_STOCK_PAPER_PARTICIPATION_SLIPPAGE_MID_PCT=2.0
PENNY_STOCK_PAPER_PARTICIPATION_SLIPPAGE_HARD_PCT=5.0
#
# Multiday paper engine tuning
# Defaults are aligned with the current multiday golden snapshot.
PENNY_STOCK_MULTIDAY_STARTER_ENTRY_FRACTION=0.05
PENNY_STOCK_MULTIDAY_WINNER_ADD_FRACTION=0.04
PENNY_STOCK_MULTIDAY_HOLD_SCORE_THRESHOLD=55.0
PENNY_STOCK_MULTIDAY_DAY2_SURVIVAL_THRESHOLD=45.0
PENNY_STOCK_MULTIDAY_REPLACEMENT_MIN_EDGE=15.0
PENNY_STOCK_MULTIDAY_MAX_ADDS=2
#
# Predictor scoring / hold-day tuning
# App defaults stay off for golden regression. Windows run_paper_drive.ps1
# enables evaluation runs with k1=1.0/k2=1.0 unless process env overrides them.
PENNY_STOCK_PAPER_PREDICTOR_WEIGHT_K1=0.0
PENNY_STOCK_PAPER_PREDICTOR_WEIGHT_K2=0.0
PENNY_STOCK_PREDICTOR_WEIGHT_TOTAL_SCORE=11.0
PENNY_STOCK_PREDICTOR_WEIGHT_CATALYST=8.0
PENNY_STOCK_PREDICTOR_WEIGHT_TECHNICAL=4.0
PENNY_STOCK_PREDICTOR_WEIGHT_SYMPATHY=3.0
PENNY_STOCK_PREDICTOR_WEIGHT_MARKET_CONTEXT=4.0
PENNY_STOCK_PREDICTOR_WEIGHT_SOCIAL=2.0
PENNY_STOCK_PREDICTOR_WEIGHT_LOW_FLOAT_BONUS=3.0
PENNY_STOCK_PREDICTOR_WEIGHT_FILING_BONUS=6.0
PENNY_STOCK_PREDICTOR_WEIGHT_MULTI_THEME_BONUS=4.0
PENNY_STOCK_PREDICTOR_MAX_HOLD_DAYS_TIER3_TOTAL=6.5
PENNY_STOCK_PREDICTOR_MAX_HOLD_DAYS_TIER3_CATALYST=1.0
PENNY_STOCK_PREDICTOR_MAX_HOLD_DAYS_TIER2_TOTAL=4.5

# Social / narrative providers
PENNY_STOCK_REDDIT_CLIENT_ID=
PENNY_STOCK_REDDIT_CLIENT_SECRET=
PENNY_STOCK_X_BEARER_TOKEN=
PENNY_STOCK_STOCKTWITS_ACCESS_TOKEN=

# Optional second-opinion reviewer
# Used by the local Gemini supervisor sidecar.
PENNY_STOCK_GEMINI_API_KEY=
PENNY_STOCK_GEMINI_MODEL=gemini-3-flash-preview
